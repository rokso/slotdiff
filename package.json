{
  "name": "slotdiff",
  "version": "0.3.0",
  "description": "Storage layout diff for upgradeable Solidity contracts: compare a local build or a live deployment against another",
  "license": "MIT",
  "author": "Rohit Solia (https://github.com/rokso)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rokso/slotdiff.git"
  },
  "homepage": "https://github.com/rokso/slotdiff#readme",
  "bugs": {
    "url": "https://github.com/rokso/slotdiff/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "slotdiff": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "build:watch": "tsc --project tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "prepublishOnly": "pnpm lint && pnpm test",
    "clean": "rm -rf dist",
    "prepack": "pnpm build"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@openzeppelin/upgrades-core": "^1.46.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.5.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "keywords": [
    "ethereum",
    "solidity",
    "upgradeable",
    "proxy",
    "storage-layout",
    "erc7201",
    "foundry",
    "hardhat"
  ],
  "sideEffects": false
}
